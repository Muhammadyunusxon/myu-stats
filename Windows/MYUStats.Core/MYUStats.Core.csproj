<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not UI: models, sampling, Claude Code's limits, settings, layout maths.
       Plain net10.0, so its tests also run on macOS; the Windows-only readers are marked as such. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MYUStats</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Strings\uz.json" LogicalName="MYUStats.Strings.uz.json" />
    <InternalsVisibleTo Include="MYUStats.Tests" />
  </ItemGroup>

</Project>
