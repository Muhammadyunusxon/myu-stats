    "Busy means 90% of a core or more, the way a stuck build or a runaway script behaves. Your own processes only; checked every 30 seconds.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Band degani yadroning 90% yoki undan koʻprogʻi, xuddi qotib qolgan build yoki toʻxtamay qolgan skript kabi. Faqat oʻzingizning jarayonlaringiz; har 30 soniyada tekshiriladi."
          }
        }
      }
    },
