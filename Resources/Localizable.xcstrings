    "%@: moved %@ to the Trash. Empty the Trash to get the space back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: moved %2$@ to the Trash. Empty the Trash to get the space back."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Savatga oʻtkazildi. Joyni qaytarish uchun Savatni boʻshating."
          }
        }
      }
    },
    "%@: moved %@ to the Trash. Some items could not be moved; they may be in use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: moved %2$@ to the Trash. Some items could not be moved; they may be in use."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ Savatga oʻtkazildi. Baʼzi elementlarni oʻtkazib boʻlmadi, ular ishlatilayotgan boʻlishi mumkin."
          }
        }
      }
    },
    "%@: nothing to clean.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: tozalanadigan narsa yoʻq."
