    "When a limit gets close": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit tugashiga yaqinlashganda"
          }
        }
      }
    },
    "When a process keeps a core busy": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarayon yadroni uzoq band qilib tursa"
          }
        }
      }
    },
    "When hidden, only a thin tab stays on the edge. Touch the edge next to it to open the pill.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yashirilganda chetda faqat ingichka tutqich qoladi. Panelni ochish uchun uning yonidagi chetga kursorni olib boring."
          }
        }
      }
    },
    "When memory pressure turns critical": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xotira bosimi kritik boʻlganda"
          }
        }
      }
    },
    "When the Mac runs hot": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac qizib ketganda"
          }
        }
      }
    },
    "When the startup disk fills up": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tizim diski toʻlganda"
          }
        }
      }
    },
    "Where the memory goes and who is using it.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xotira qayerga ketmoqda va uni kim ishlatmoqda."
          }
        }
      }
    },
    "Wi-Fi, Ethernet and cellular only; VPN tunnels are left out so traffic is not counted twice.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat Wi-Fi, Ethernet va mobil tarmoq; trafik ikki marta hisoblanmasligi uchun VPN tunnellari kiritilmagan."
          }
        }
      }
    },
    "Wired": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahkamlangan"
          }
        }
      }
    },
    "Xcode archives · keep the ones you may need to re-export": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode arxivlari · qayta eksport qilish kerak boʻlishi mumkinlarini saqlang"
          }
        }
      }
    },
    "Xcode build products · rebuilt on next build": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode build natijalari · keyingi buildda qayta yaratiladi"
          }
        }
      }
    },
    "Yarn cache": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarn keshi"
          }
        }
      }
    },
    "Your own processes only; system daemons need administrator rights to read.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat oʻzingizning jarayonlaringiz; tizim demonlarini oʻqish uchun administrator huquqi kerak."
          }
        }
      }
    },
    "macOS asks for permission when you turn on the first alert.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinchi ogohlantirishni yoqqaningizda macOS ruxsat soʻraydi."
          }
        }
      }
    },
    "npm cache · `npm cache clean --force`": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "npm keshi · `npm cache clean --force`"
          }
        }
      }
    }
