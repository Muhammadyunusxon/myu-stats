    "A notification opens the page it is about. Each alert comes once, and again only after things have gone back to normal.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirishnoma bosilsa, u haqidagi sahifa ochiladi. Har bir ogohlantirish bir marta keladi va holat meʼyorga qaytgandan keyingina yana keladi."
          }
        }
      }
    },
    "Above": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegara"
          }
        }
      }
    },
    "Above %@ for over a minute.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir daqiqadan koʻproq vaqt %@ dan yuqori."
          }
        }
      }
    },
    "After a minute at critical, when macOS is short of memory and the Mac slows down.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bosim bir daqiqa kritik boʻlib tursa: macOSʼda xotira yetishmayapti va Mac sekinlashadi."
          }
        }
      }
    },
