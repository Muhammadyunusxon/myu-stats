{
  "sourceLanguage": "en",
  "strings": {
    "%@ CPU for over %lld minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ CPU for over %2$lld minutes."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld daqiqadan koʻproq vaqtdan beri %1$@ CPU ishlatmoqda."
          }
        }
      }
    },
    "%@ busy": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ band"
          }
        }
      }
    },
    "%@ could not be cleaned: the command failed. Is Xcode installed?": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tozalanmadi: buyruq bajarilmadi. Xcode oʻrnatilganmi?"
          }
        }
      }
    },
    "%@ free of %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ free of %2$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ boʻsh, jami %2$@"
          }
        }
      }
    },
    "%@ free on %@. Disk details show what takes the space and which caches can go.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ free on %2$@. Disk details show what takes the space and which caches can go."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ diskida %1$@ boʻsh joy qoldi. Disk tafsilotlarida joyni nima egallayotgani va qaysi keshlarni tozalash mumkinligi koʻrsatilgan."
          }
        }
      }
    },
    "%@ is keeping a core busy": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bitta yadroni band qilib turibdi"
          }
        }
      }
    },
